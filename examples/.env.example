# Copy to examples/.env, fill in the test credentials, then source it in your shell.
# Never commit a file containing real credentials.
DIIA_ENV=sandbox
DIIA_ACQUIRER_TOKEN=
DIIA_AUTH_ACQUIRER_TOKEN=

# Example branch details for the sandbox. Replace with your own details before
# using the examples against production.
DIIA_BRANCH_NAME="Sandbox demo"
DIIA_BRANCH_EMAIL="sandbox-qa@example.com"
DIIA_BRANCH_REGION="Kyiv"
DIIA_BRANCH_DISTRICT="Shevchenkivskyi"
DIIA_BRANCH_LOCATION="Kyiv"
DIIA_BRANCH_STREET="Testova"
DIIA_BRANCH_HOUSE="1"
DIIA_OFFER_NAME="Sandbox document sharing"

# Set these after the create commands print their IDs.
DIIA_BRANCH_ID=
DIIA_OFFER_ID=
DIIA_REQUEST_ID=

# Set only when needed. The barcode must come from a test user's Diia app.
DIIA_BARCODE=
DIIA_RETURN_LINK=
DIIA_SHOW_DEEPLINK=
DIIA_ALLOW_PRODUCTION_MUTATIONS=

# Explicitly acknowledge that branch update sends a full PUT and may drop
# server fields that the SDK does not model. Keep empty for normal runs.
DIIA_ALLOW_BRANCH_REPLACEMENT=
